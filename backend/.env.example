# LLM API Keys (Stored strictly on server, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
PREFERRED_LLM=gemini

# Cloud Database URL (Optional - defaults automatically to local SQLite if left empty)
# Compatible with Neon, Supabase, Render, Railway, AWS RDS, GCP Cloud SQL, or any PostgreSQL/MySQL
# Example for Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

